ANTHROPIC_API_KEY=sk-ant-...        # optional — leave unset to think on your Claude subscription
TELEGRAM_BOT_TOKEN=123456:ABC...    # only needed for the Telegram face
SQUIDCLAW_BRAIN=cli                 # "cli" (subscription) or "api" (key). Auto-detects if unset.
SQUIDCLAW_UI_PORT=4200              # the canvas (read-only dashboard)
SQUIDCLAW_UI_TOKEN=                 # if set, the canvas requires ?token=… (REQUIRED if exposed)
SQUIDCLAW_MASTER_KEY=               # >=16 chars; encrypts tenant credentials. Losing it loses them all.
SQUIDCLAW_ADMIN_CHAT=               # your Telegram chat id(s), comma-separated — /tenant commands
